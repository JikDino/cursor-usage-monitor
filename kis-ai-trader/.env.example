# ===== 한국투자증권 Open API =====
# https://apiportal.koreainvestment.com 에서 앱키 발급 (모의투자용/실전용 키가 서로 다름)
KIS_APP_KEY=
KIS_APP_SECRET=
# 계좌번호 앞 8자리 / 뒤 2자리(상품코드, 보통 01)
KIS_ACCOUNT_NO=12345678
KIS_ACCOUNT_PRODUCT=01
# paper = 모의투자, real = 실전투자 (실전은 KIS_CONFIRM_REAL=YES 와 --live 플래그가 추가로 필요)
KIS_ENV=paper
KIS_CONFIRM_REAL=NO

# ===== AI(LLM) =====
# openai | anthropic | none(규칙 기반 분석가 사용)
# openai 는 OpenAI 호환 API(Gemini/Ollama/vLLM 등)도 LLM_BASE_URL 로 사용 가능
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_BASE_URL=

# ===== 매매 설정 =====
# kis = 한투 계좌(모의/실전)로 주문, sim = 로컬 가상계좌(시세만 한투에서 조회)
BROKER=kis
SIM_INITIAL_CASH=10000000
# 콤마로 구분된 관심종목. 비우면 기본 대형주 유니버스 사용
WATCHLIST=
# 거래량 순위 API로 종목 발굴 (모의투자 서버는 미지원이라 자동으로 건너뜀)
USE_VOLUME_RANK=true
CANDIDATES=10
LOOP_INTERVAL_MIN=30
DB_PATH=data/trader.db

# ===== 리스크 한도 (AI가 넘을 수 없는 하드 제약) =====
MAX_POSITIONS=5
MAX_POSITION_PCT=0.20
MIN_CASH_PCT=0.10
RISK_PER_TRADE_PCT=0.01
STOP_LOSS_PCT=0.05
TAKE_PROFIT_PCT=0.15
TRAILING_STOP_PCT=0.07
DAILY_LOSS_LIMIT_PCT=0.03
MIN_CONFIDENCE=0.6
MAX_TRADES_PER_DAY=10
